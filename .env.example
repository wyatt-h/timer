# Public. Sent to the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Read exclusively by the /api route handlers that create event
# controller credentials, validate event sessions, and write event state.
#
# This key bypasses Row Level Security, which is the point: the credential and
# session tables are unreachable by `anon` and `authenticated`, so nothing but a
# server-side request can touch them. Never rename it with a NEXT_PUBLIC_ prefix
# and never commit a real value — either would publish full database access.
#
# Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. HMAC key for the login-name and client-address hashes the login rate
# limiter stores, so that table holds no recoverable usernames or IP addresses.
# Any long random string. Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
# EVENT_AUTH_HASH_PEPPER=any-long-random-string
